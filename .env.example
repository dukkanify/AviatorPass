# =============================================================================
# Aviation Education Platform (AEP) — Environment Variables
# Copy to .env.local for local development. Never commit secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AviatorPass
NEXT_PUBLIC_APP_ENV=development

# Supabase — Project URL & anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Service role (server-only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Database (optional Prisma direct connection)
DATABASE_URL=
DIRECT_URL=

# Auth
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
AUTH_OTP_EXPIRY_MINUTES=10
AUTH_SECRET=aep-dev-auth-secret-change-me-in-prod
AUTH_SESSION_DAYS=7
AUTH_REMEMBER_ME_DAYS=30

# Local / demo OTP (disabled when NODE_ENV=production unless FORCE_DEMO_OTP=true
# or NEXT_PUBLIC_APP_ENV is not production — needed for CI Playwright `next start`)
ENABLE_DEMO_OTP=true
FORCE_DEMO_OTP=true
DEMO_OTP_CODE=123456

# Outbound email: prefer Platform Settings (Super Admin → Email). Optional env
# overrides can be mirrored into settings. Without SMTP host, messages are
# stored in `.data/aep-email-outbox.json` (inspect via /api/admin/settings/email-outbox).

# Super Admin seeder
SUPER_ADMIN_EMAIL=superadmin@eagerpilots.com
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Zoom Server-to-Server OAuth (optional — mock mode when unset)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET=

# Stripe (prefer restricted keys rk_live_…)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Catalog — one Product, one Price per currency (never app-side FX)
# STRIPE_PRODUCT_ID=prod_...
# STRIPE_PRICE_USD=price_...
# STRIPE_PRICE_GBP=price_...
# STRIPE_PRICE_EUR=price_...
# STRIPE_PRICE_AED=price_...
# STRIPE_PRICE_SAR=price_...
# STRIPE_PRICE_KWD=price_...
# STRIPE_PRICE_BHD=price_...
# STRIPE_PRICE_QAR=price_...
# STRIPE_PRICE_OMR=price_...
# STRIPE_PRICE_EGP=price_...
# STRIPE_PRICE_JOD=price_...
# STRIPE_PRICE_CAD=price_...
# STRIPE_PRICE_AUD=price_...
# STRIPE_PRICE_NZD=price_...
# STRIPE_PRICE_SGD=price_...
# STRIPE_PRICE_MYR=price_...
# STRIPE_PRICE_JPY=price_...
# STRIPE_PRICE_INR=price_...
# STRIPE_PRICE_TRY=price_...
# STRIPE_PRICE_ZAR=price_...
# Optional: npm run stripe:sync with STRIPE_UNIT_AMOUNT_<CCY> set by the operator

# Feature flags
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_REALTIME=true

# Storage
NEXT_PUBLIC_STORAGE_BUCKET=aep-uploads
