# =============================================================================
# Aviation Education Platform (AEP) — Environment Variables
# Copy to .env.local for local development. Never commit secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AviatorPass
NEXT_PUBLIC_APP_ENV=development

# Supabase — Project URL & anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Service role (server-only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Database (optional Prisma direct connection)
DATABASE_URL=
DIRECT_URL=

# Auth
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
AUTH_OTP_EXPIRY_MINUTES=10
AUTH_SECRET=aep-dev-auth-secret-change-me-in-prod
AUTH_SESSION_DAYS=7
AUTH_REMEMBER_ME_DAYS=30

# Local / demo OTP (disabled when NODE_ENV=production unless FORCE_DEMO_OTP=true
# or NEXT_PUBLIC_APP_ENV is not production — needed for CI Playwright `next start`)
ENABLE_DEMO_OTP=true
FORCE_DEMO_OTP=true
DEMO_OTP_CODE=123456

# Outbound email: prefer Platform Settings (Super Admin → Email). Optional env
# overrides can be mirrored into settings. Without SMTP host, messages are
# stored in `.data/aep-email-outbox.json` (inspect via /api/admin/settings/email-outbox).

# Super Admin seeder
SUPER_ADMIN_EMAIL=superadmin@aviatorpass.com
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Zoom General OAuth (instructor connect) + optional Server-to-Server fallback
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=https://www.aviatorpass.com/api/integrations/zoom/callback
# ZOOM_BASE_URL=https://api.zoom.us/v2
# ZOOM_SECRET_TOKEN=
# ZOOM_WEBHOOK_SECRET=
# ZOOM_ACCOUNT_ID=

# Stripe (server secrets only — never commit values)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Production webhook: https://www.aviatorpass.com/api/payments/webhook
# Checkout uses AviatorPass course price_data. Do not set Stripe Product or Price IDs.

# Tamara (server secrets only — never commit values)
# TAMARA_API_TOKEN=
# TAMARA_BASE_URL=https://api-sandbox.tamara.co
# Production: TAMARA_BASE_URL=https://api.tamara.co
# Optional webhook JWT secret from the Tamara partner portal:
# TAMARA_NOTIFICATION_TOKEN=
# Production webhook: https://www.aviatorpass.com/api/payments/tamara/webhook

# Feature flags
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_REALTIME=true

# Storage
NEXT_PUBLIC_STORAGE_BUCKET=aep-uploads
