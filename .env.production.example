# =============================================================================
# Production environment template — copy to .env.production / Vercel env vars
# Never commit real secrets.
# Staging test domain: https://dubai-test.blog — see docs/DOMAIN_DUBAI_TEST.md
# Production canonical URL: https://www.aviatorpass.com
# =============================================================================

NEXT_PUBLIC_APP_URL=https://www.aviatorpass.com
NEXT_PUBLIC_APP_NAME="AviatorPass"
NEXT_PUBLIC_APP_ENV=production

# Required — strong unique secret (≥24 characters)
AUTH_SECRET=

AUTH_SESSION_DAYS=7
AUTH_REMEMBER_ME_DAYS=30
AUTH_OTP_EXPIRY_MINUTES=10

# MUST be false in production
ENABLE_DEMO_OTP=false
# Leave unset in production
# DEMO_OTP_CODE=

SUPER_ADMIN_EMAIL=ops@example.com
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

NEXT_PUBLIC_AUTH_REDIRECT_URL=https://www.aviatorpass.com/auth/callback
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_STORAGE_BUCKET=aep-uploads

# Zoom General OAuth (instructor connect) + optional S2S fallback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://www.aviatorpass.com/api/integrations/zoom/callback
ZOOM_BASE_URL=https://api.zoom.us/v2
ZOOM_SECRET_TOKEN=
ZOOM_WEBHOOK_SECRET=
ZOOM_ACCOUNT_ID=

# Stripe — AviatorPass is the catalog. Stripe only processes payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Tamara — hosted checkout. Never commit the API token.
TAMARA_API_TOKEN=
TAMARA_BASE_URL=https://api.tamara.co
# Optional HS256 secret from Tamara partner portal (webhook JWT)
TAMARA_NOTIFICATION_TOKEN=

# Taly — hosted checkout. Never commit merchant keys.
TALY_API_KEY=
TALY_SECRET_KEY=
TALY_WEBHOOK_SECRET=
TALY_BASE_URL=https://api.taly.io

# Email — Resend (preferred). Domain aviatorpass.com must be verified in Resend.
EMAIL_PROVIDER=resend
EMAIL_FROM=AviatorPass <noreply@aviatorpass.com>
EMAIL_FROM_NAME=AviatorPass
ADMIN_NOTIFICATION_EMAIL=
RESEND_API_KEY=
# Optional SMTP fallback (Namecheap / web-hosting.com)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@aviatorpass.com
# SMTP_FROM_NAME=AviatorPass
CRON_SECRET=

# Cursor / GitHub production deploy (values live in secrets, never in git)
# POST only $VERCEL_AVIATORPASS_DEPLOY_HOOK — never hardcode a hook URL.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_AVIATORPASS_DEPLOY_HOOK=
